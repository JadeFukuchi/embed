# ---- Shopify ----
SHOPIFY_STORE=panoresortwear.myshopify.com
# Token do app customizado (Settings > Apps > Develop apps), escopos:
#   read_products, write_products
SHOPIFY_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2025-07
# Plano padrao = 2 chamadas/seg. Shopify Plus = 4.
SHOPIFY_RPS=2

# ---- Bagy / Dooca (apenas para --fonte=bagy) ----
BAGY_API=https://api.dooca.store
BAGY_TOKEN=
# Usado quando a API devolve caminho relativo em vez de URL completa.
BAGY_CDN_BASE=https://cdn.dooca.store/9528

# ---- Redimensionamento ----
# Lado maior da imagem enviada. 2048 e o recomendado pela Shopify para produto
# (com zoom bom). Ate 4000 tambem passa (16 MP < 20 MP).
MAX_DIM=2048
JPEG_QUALITY=85

# Preencha SOMENTE se `node diagnostico.js <url>` mostrar que o CDN da Bagy
# aceita redimensionar por querystring. Ex.: CDN_RESIZE_PARAMS=w=2048&h=2048&fit=contain
CDN_RESIZE_PARAMS=

ARQUIVO_ESTADO=estado.jsonl
